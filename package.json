{
  "main": ".vite/build/electron.js",
  "name": "mineprompt",
  "productName": "MinePrompt",
  "author": "pix3lpirat3",
  "version": "2.0.0-beta.21",
  "description": "A secure cross-platform command client for Minecraft Java Edition.",
  "scripts": {
    "postinstall": "node scripts/apply-dependency-patches.js && node packages/mineflayer-ui/build.cjs",
    "build:ui": "node packages/mineflayer-ui/build.cjs",
    "start": "npm run build:ui && electron-forge start",
    "start:headless": "npm run build:ui && node src/headless.js serve",
    "start:mcp": "npm run build:ui && node src/mcp.js",
    "tools:export": "npm run build:ui && node src/headless.js tools --format openai",
    "package": "npm run build:ui && electron-forge package",
    "make": "npm run build:ui && electron-forge make",
    "check": "npm run build:ui && npm run lint && npm run typecheck && npm test",
    "audit": "npm audit",
    "audit:production": "npm audit --omit=dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js && vitest run",
    "test:desktop": "npm run package && node scripts/desktop-smoke.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pix3lPirat3/mineprompt_rewritten.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Pix3lPirat3/mineprompt_rewritten/issues"
  },
  "homepage": "https://github.com/Pix3lPirat3/mineprompt_rewritten#readme",
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "electron-squirrel-startup": "^1.0.1",
    "minecraft-folder-path": "^1.2.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-chat": "^1.13.0",
    "prismarine-nbt": "^2.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "vec3": "^0.2.0",
    "xstate": "^5.33.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "extract-zip": "file:vendor/extract-zip",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "extract-zip": "$extract-zip",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "esbuild@0.28.2": true
  }
}
